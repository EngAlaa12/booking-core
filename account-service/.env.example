# Copy to .env and adjust if you need non-default values.
# account-service reads these at startup; every variable has a working
# local default, so .env is optional unless you want to override something.

# --- account-service datasource ---
DB_URL=jdbc:postgresql://localhost:5432/account_db
DB_USERNAME=account
DB_PASSWORD=account

# --- account-service server ---
SERVER_PORT=8081

# --- account-service JWT ---
JWT_ISSUER=account-service
JWT_ACCESS_TOKEN_TTL=PT15M
# Leave blank to auto-generate an ephemeral RSA key pair on startup (dev only).
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=
